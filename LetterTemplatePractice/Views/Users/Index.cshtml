</style>
<script>
(function () {
    // Edit modal population
    var editModal = document.getElementById('editUserModal');
    if (editModal) {
        editModal.addEventListener('show.bs.modal', function (event) {
            var btn = event.relatedTarget;
            if (!btn) return;
            document.getElementById('editId').value = btn.getAttribute('data-id') || '';
            document.getElementById('editUsername').value = btn.getAttribute('data-username') || '';
            document.getElementById('editEmail').value = btn.getAttribute('data-email') || '';
            document.getElementById('editDisplayName').value = btn.getAttribute('data-displayname') || '';
            document.getElementById('editRole').value = btn.getAttribute('data-role') || 'User';
            document.getElementById('editIsActive').checked = btn.getAttribute('data-active') === 'true';
            document.getElementById('editIsHiddenProfile').checked = btn.getAttribute('data-hidden') === 'true';
        });

        // Ensure unchecked checkboxes still post false
        editModal.querySelector('form').addEventListener('submit', function () {
            var active = document.getElementById('editIsActive');
            var hidden = document.getElementById('editIsHiddenProfile');
            var activeFalse = document.getElementById('editIsActiveFalse');
            var hiddenFalse = document.getElementById('editIsHiddenFalse');
            activeFalse.disabled = active.checked;
            hiddenFalse.disabled = hidden.checked;
        });
    }

    // Reset password modal
    var resetModal = document.getElementById('resetPasswordModal');
    if (resetModal) {
        resetModal.addEventListener('show.bs.modal', function (event) {
            var btn = event.relatedTarget;
            if (!btn) return;
            var username = btn.getAttribute('data-username') || '';
            document.getElementById('resetId').value = btn.getAttribute('data-id') || '';
            document.getElementById('resetUsername').value = username;
            document.getElementById('resetUsernameLabel').textContent = '@@' + username;
            document.getElementById('resetNewPassword').value = '';
            document.getElementById('resetConfirmPassword').value = '';
        });
    }

    // Delete modal
    var deleteModal = document.getElementById('deleteUserModal');
    if (deleteModal) {
        deleteModal.addEventListener('show.bs.modal', function (event) {
            var btn = event.relatedTarget;
            if (!btn) return;
            var username = btn.getAttribute('data-username') || '';
            document.getElementById('deleteId').value = btn.getAttribute('data-id') || '';
            document.getElementById('deleteUsernameLabel').textContent = '@@' + username;
        });
    }

    // Client-side password match checks
    function wirePasswordMatch(formSelector, aId, bId) {
        var form = document.querySelector(formSelector);
        if (!form) return;
        form.addEventListener('submit', function (e) {
            var a = document.getElementById(aId);
            var b = document.getElementById(bId);
            if (a && b && a.value !== b.value) {
                e.preventDefault();
                b.setCustomValidity('Passwords do not match.');
                b.reportValidity();
            } else if (b) {
                b.setCustomValidity('');
            }
        });
    }
    wirePasswordMatch('#createUserModal form', 'createPassword', 'createConfirmPassword');
    wirePasswordMatch('#resetPasswordModal form', 'resetNewPassword', 'resetConfirmPassword');
})();
</script>
}
